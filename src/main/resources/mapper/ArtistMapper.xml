<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.solvd.musicstreamingservice.persistence.ArtistRepository">

    <resultMap id="artistResultMap" type="Artist">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="country" column="country"/>
        <result property="musicServiceId" column="music_service_id"/>
    </resultMap>

    <insert id="create" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO artists (name, country, music_service_id)
        VALUES (#{name}, #{country}, #{musicServiceId})
    </insert>

    <select id="findById" resultMap="artistResultMap">
        SELECT * FROM artists WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="artistResultMap">
        SELECT * FROM artists
    </select>

    <update id="update">
        UPDATE artists
        SET name = #{name},
        country = #{country},
        music_service_id = #{musicServiceId}
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM artists WHERE id = #{id}
    </delete>

    <select id="findByMusicServiceId" resultMap="artistResultMap">
        SELECT * FROM artists WHERE music_service_id = #{musicServiceId}
    </select>

    <select id="findByCountry" resultMap="artistResultMap">
        SELECT * FROM artists WHERE country = #{country}
    </select>
</mapper>