<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.solvd.musicstreamingservice.persistence.AlbumRepository">

    <resultMap id="albumResultMap" type="Album">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="releaseDate" column="release_date"/>
        <result property="artistId" column="artist_id"/>
    </resultMap>

    <insert id="create" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO albums (title, release_date, artist_id)
        VALUES (#{title}, #{releaseDate}, #{artistId})
    </insert>

    <select id="findById" resultMap="albumResultMap">
        SELECT * FROM albums WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="albumResultMap">
        SELECT * FROM albums
    </select>

    <update id="update">
        UPDATE albums
        SET title = #{title},
        release_date = #{releaseDate},
        artist_id = #{artistId}
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM albums WHERE id = #{id}
    </delete>

    <select id="findByArtistId" resultMap="albumResultMap">
        SELECT * FROM albums WHERE artist_id = #{artistId}
    </select>
</mapper>